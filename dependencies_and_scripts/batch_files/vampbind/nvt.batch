#!/bin/bash
#SBATCH -J NVT                          
#SBATCH -t 9:00:00                                                            
#SBATCH --ntasks=1                 
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1                                                 

#SBATCH -A zerze                             

#SBATCH --mail-user=mtelikepalli@gmail.com 
#SBATCH --mail-type=BEGIN,END,FAIL

##### Modules for loading Grace, GROMACS, and python
if [ -n "$NOGPU_JOB_ID" ]; then
    echo "Cancelling no-GPU job $NOGPU_JOB_ID because GPU job $SLURM_JOB_ID started"
    scancel $NOGPU_JOB_ID
fi
module load GROMACS/2023.5-foss-2023a-CUDA-12.1.1-PLUMED-2.9.0

#### Sample of running a GROMACS code
gmx grompp -f ./Dependencies_and_scripts/mdynamics/mdp_files/nvt.mdp -c em.gro -r em.gro -p topol_updated.top -n index_named.ndx -o nvt.tpr -maxwarn 2
gmx mdrun -deffnm nvt -ntomp 8 -v -ntmpi 1
touch output_done_${SLURM_JOB_ID}.flag 
