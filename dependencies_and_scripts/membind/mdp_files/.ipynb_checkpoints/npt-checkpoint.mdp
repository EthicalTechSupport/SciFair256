title       = NPT_Equilibration
define      = -DPOSRES
integrator  = md
dt          = 0.02
nsteps      = 10000        ; should be 250000 -> 5 ns
nstenergy   = 100
nstlog      = 100
nstxout-compressed = 5000   ; Write every 100 ps

; Cutoffs
cutoff-scheme   = Verlet
rlist           = 1.1
rcoulomb        = 1.1
rvdw            = 1.1
coulombtype     = Reaction-Field
epsilon_r       = 15
epsilon_rf      = 0
vdwtype         = cutoff

; Temperature coupling
Tcoupl      = Berendsen
tc-grps     = Protein Membrane Solvent
tau_t       = 1.0   1.0     1.0
ref_t       = 323   323     323

; Pressure coupling
pcoupl      = Berendsen
pcoupltype  = isotropic
tau_p       = 1.0
compressibility = 5e-6
ref_p       = 1.0
refcoord_scaling = com

; Constraints
constraints = none
continuation = yes

; Periodic boundary conditions
pbc         = xyz

; Velocity generation
gen_vel = no