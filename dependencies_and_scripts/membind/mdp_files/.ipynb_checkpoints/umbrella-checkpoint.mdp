title                    = Umbrella sampling window
define                   = -DPOSRES_B

integrator               = md
dt                       = 0.002               ; 2 fs timestep
nsteps                   = 25000000            ; 50 ns window sampling
nstxout-compressed       = 5000
nstenergy                = 5000
nstlog                   = 5000

constraints = no

cutoff-scheme            = Verlet
nstlist                  = 20
ns_type                  = grid
rlist                    = 1.1
rcoulomb                 = 1.1
rvdw                     = 1.1

coulombtype              = Reaction-Field
epsilon_r                = 15
vdwtype                  = cut-off
DispCorr                 = EnerPres

tcoupl                   = Nose-Hoover
tc-grps                  = Protein Non-Protein
tau_t                    = 1.0 1.0
ref_t                    = 310 310

pcoupl                   = v-rescale
pcoupltype               = isotropic
tau_p                    = 12.0
compressibility          = 3e-4
ref_p                    = 1.0

pbc                      = xyz

gen_vel                  = no

; Pull code with zero pulling rate to keep umbrella window restrained at fixed distance
pull                     = yes
pull_ngroups             = 2
pull_ncoords             = 1

pull_group1_name         = Protein
pull_group2_name         = Upper_PO4

pull_coord1_type         = umbrella
pull_coord1_geometry     = distance
pull_coord1_dim          = N N Y
pull_coord1_groups       = 1 2
pull_coord1_start        = no
pull_coord1_rate         = 0.0
pull_coord1_k            = 1000
