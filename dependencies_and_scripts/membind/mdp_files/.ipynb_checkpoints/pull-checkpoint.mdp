title                    = Pulling simulation
define                   = -DPOSRES_B          ; Position restraints on membrane

integrator               = md
dt                       = 0.002               ; 2 fs timestep
nsteps                   = 5000000             ; 10 ns pulling (adjust as needed)
nstxout-compressed       = 5000
nstenergy                = 5000
nstlog                   = 5000

constraint_algorithm     = lincs
constraints             = all-bonds
continuation             = yes

cutoff-scheme            = Verlet
nstlist                  = 20
ns_type                  = grid
rlist                    = 1.1
rcoulomb                 = 1.1
rvdw                     = 1.1

coulombtype              = Reaction-Field
epsilon_r                = 15
vdwtype                  = cut-off
DispCorr                 = EnerPres

tcoupl                   = Nose-Hoover
tc-grps                  = Protein Non-Protein
tau_t                    = 1.0 1.0
ref_t                    = 310 310

pcoupl                   = Parrinello-Rahman
pcoupltype               = isotropic
tau_p                    = 12.0
compressibility          = 3e-4
ref_p                    = 1.0

pbc                      = xyz

gen_vel                  = no

; Pull code to pull protein along z away from membrane
pull                     = yes
pull_ngroups             = 2
pull_ncoords             = 1

pull_group1_name         = N_Terminal
pull_group2_name         = Upper_PO4

pull_coord1_type         = umbrella
pull_coord1_geometry     = distance
pull_coord1_dim          = N N Y             ; pull along z only
pull_coord1_groups       = 1 2
pull_coord1_start        = yes               ; use initial distance
pull_coord1_rate         = 0.0005            ; nm per ps (0.5 m/s pulling speed)
pull_coord1_k            = 1000              ; force constant kJ mol^-1 nm^-2